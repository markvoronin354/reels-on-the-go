<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Top Swipe Arrow (Upward Reel Navigation) -->
    <path
        android:pathData="M47,28 L54,21 L61,28"
        android:strokeWidth="3.5"
        android:strokeColor="#00F5D4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Steering Wheel Outer Rim -->
    <path
        android:pathData="M54,34 A20,20 0 1,1 53.99,34"
        android:strokeWidth="3.5"
        android:strokeColor="#F8FAFC"
        android:fillColor="#00000000"
        android:strokeLineCap="round" />

    <!-- Wheel Spokes -->
    <path
        android:pathData="M34,54 L44,54 M64,54 L74,54 M54,64 L54,74"
        android:strokeWidth="3.0"
        android:strokeColor="#F8FAFC"
        android:strokeLineCap="round" />

    <!-- Center Hub Circle with Gradient -->
    <path android:pathData="M54,44 A10,10 0 1,1 53.99,44">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="44"
                android:startY="44"
                android:endX="64"
                android:endY="64"
                android:type="linear">
                <item android:color="#7C3AED" android:offset="0.0" />
                <item android:color="#2563EB" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Play Icon inside Hub -->
    <path
        android:pathData="M52,49.5 L58,54 L52,58.5 Z"
        android:fillColor="#FFFFFF" />

    <!-- Bottom Swipe Arrow (Downward Reel Navigation) -->
    <path
        android:pathData="M47,80 L54,87 L61,80"
        android:strokeWidth="3.5"
        android:strokeColor="#00F5D4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

</vector>
